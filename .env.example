# =============================================================================
# Rapid Crisis Response System — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# =============================================================================

# Emergency Configuration
# PIN used to cancel an active SOS alert
NEXT_PUBLIC_CANCEL_PIN=1234

# =============================================================================
# Firebase Configuration
# Get these from: https://console.firebase.google.com → Project Settings → General
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# =============================================================================
# Maps Configuration (optional — used for map features)
# =============================================================================
# Google Maps: https://console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Mapbox: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# =============================================================================
# Twilio — SMS Notifications (optional — leave blank for Demo Mode)
# Get these from: https://console.twilio.com
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
